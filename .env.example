# Lumen server -> DeepSeek proxy
DEEPSEEK_PROXY_URL=https://your-proxy.example.com/api/chat
DEEPSEEK_PROXY_TOKEN=replace_with_a_long_random_secret

# Used by vercel-proxy (configure these on Vercel, not in browser code)
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
LUMEN_PROXY_TOKEN=replace_with_the_same_long_random_secret
DEEPSEEK_MODEL=deepseek-chat
